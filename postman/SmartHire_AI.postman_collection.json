{
  "info": {
    "name": "SmartHire AI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Auth first. Tokens and ids are saved to collection variables."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register recruiter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Recruiter\",\n  \"email\": \"new.recruiter@example.test\",\n  \"password\": \"Password@123\",\n  \"role\": \"RECRUITER\",\n  \"companyName\": \"Example Co\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('recruiterToken', j.token);"
                ]
              }
            }
          ]
        },
