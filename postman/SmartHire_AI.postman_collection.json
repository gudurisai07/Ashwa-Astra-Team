    {
      "name": "Jobs",
      "item": [
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs?q=&skill=&maxExperience=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs"
              ],
              "query": [
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "skill",
                  "value": ""
                },
                {
                  "key": "maxExperience",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        },
        {
          "name": "My jobs (recruiter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "mine"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Create job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer\",\n  \"companyName\": \"Example Co\",\n  \"description\": \"Build Spring Boot services.\",\n  \"requiredSkills\": \"Java, Spring Boot, MySQL\",\n  \"experience\": 2,\n  \"salaryRange\": \"INR 8-12 LPA\",\n  \"location\": \"Hyderabad\",\n  \"employmentType\": \"Full-time\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('jobId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update job",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Engineer II\",\n  \"companyName\": \"Example Co\",\n  \"description\": \"Build Spring Boot services.\",\n  \"requiredSkills\": \"Java, Spring Boot, MySQL\",\n  \"experience\": 3,\n  \"salaryRange\": \"INR 10-14 LPA\",\n  \"location\": \"Hyderabad\",\n  \"employmentType\": \"Full-time\",\n  \"status\": \"ACTIVE\"\n}"
            }
          }
        },
        {
          "name": "Close job",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{recruiterToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
